  lines:
  - speaker: 0
    text: "C\xF4\u2026 \u0111ang h\u1ECFi t\u1EDB m\xE0."
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 1
    text: "V\xEC c\xF4 \u0111ang ph\u1EA3i lo cho c\u1EADu \u0111\u1EA5y."
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 0
    text: "T\u1EDB bi\u1EBFt. Nh\u01B0ng c\xF4 ch\u01B0a tr\xE1ch t\u1EDB."
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 1
    text: "C\xF4 kh\xF4ng c\u1EA7n n\xF3i ra."
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 0
    text: "\u2026C\u1EADu \u0111\xE2u bi\u1EBFt ch\u1EAFc."
