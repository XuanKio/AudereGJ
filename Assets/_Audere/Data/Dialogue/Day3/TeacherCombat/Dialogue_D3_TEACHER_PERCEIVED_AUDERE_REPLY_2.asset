  m_Name: Dialogue_D3_TEACHER_PERCEIVED_AUDERE_REPLY_2
  m_EditorClassIdentifier: 
  dialogueId: d3-teacher-perceived-audere-reply-2
  leftCharacter: 1
  rightCharacter: 2
  leftPortraitOverride: {fileID: 5111810106087816393, guid: b7d038e70866c98478cb41d1c19a092d, type: 3}
  rightPortraitOverride: {fileID: -4747829306167941163, guid: cdecd5c621db74b43927eb49d1f04191, type: 3}
  lines:
  - speaker: 0
    text: "C\xF4 b\u1EA3o t\u1EDB ngh\u1EC9 m\u1ED9t ch\xFAt."
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 1
    text: "C\u1EADu ngh\u0129 c\xF4 kh\xF4ng th\u1EA5y phi\u1EC1n \xE0?"
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 0
    text: "H\xF4m qua, c\u1EADu c\u0169ng n\xF3i th\u1EBF v\u1EC1 Bianca."
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 0
    text: "Nh\u01B0ng c\u1EADu \u1EA5y \u0111\xE3 c\xF9ng t\u1EDB s\u1EEDa l\u1EA1i."
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 1
    text: "L\u1EA7n n\xE0y c\xF3 th\u1EC3 kh\xE1c."
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 0
    text: "C\xF3 th\u1EC3\u2026 \u0111\xE2u ph\u1EA3i l\xE0 ch\u1EAFc ch\u1EAFn."
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
