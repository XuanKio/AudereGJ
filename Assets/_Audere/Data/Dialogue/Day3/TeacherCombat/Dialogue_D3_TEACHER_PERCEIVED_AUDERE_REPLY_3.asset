  m_Script: {fileID: 11500000, guid: 988dc6f5856c55141a8b5eb029f35e6d, type: 3}
  m_Name: Dialogue_D3_TEACHER_PERCEIVED_AUDERE_REPLY_3
  m_EditorClassIdentifier: 
  dialogueId: d3-teacher-perceived-audere-reply-3
  leftCharacter: 1
  rightCharacter: 2
  leftPortraitOverride: {fileID: 5111810106087816393, guid: b7d038e70866c98478cb41d1c19a092d, type: 3}
  rightPortraitOverride: {fileID: -4747829306167941163, guid: cdecd5c621db74b43927eb49d1f04191, type: 3}
  lines:
  - speaker: 0
    text: "Timor, \u0111\u1EEBng n\xF3i thay c\xF4 n\u1EEFa."
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 1
    text: "T\u1EDB ch\u1EC9 kh\xF4ng mu\u1ED1n c\u1EADu b\u1ECB t\u1ED5n th\u01B0\u01A1ng."
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 0
    text: "T\u1EDB bi\u1EBFt\u2026 T\u1EDB v\u1EABn s\u1EE3."
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 0
    text: "Nh\u01B0ng t\u1EDB \u0111ang m\u1EC7t th\u1EADt."
    portraitOverride: {fileID: 4102350588037513078, guid: f24416efd39bdb9469a2068f6e9639c4, type: 3}
    glitchPortraitTransition: 0
  - speaker: 0
    text: "T\u1EDB mu\u1ED1n nghe c\xF4 n\xF3i."
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 1
    text: "Audere\u2014"
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 0
    text: "\u0110\u1EC3 t\u1EDB t\u1EF1 tr\u1EA3 l\u1EDDi."
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
