  lines:
  - speaker: 1
    text: "C\xF4 ph\u1EA3i d\u1EEBng vi\u1EC7c v\xEC c\u1EADu \u0111\u1EA5y."
    characterOverride: 0
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 0
    text: "C\xF4 ch\u1EC9 h\u1ECFi t\u1EDB th\xF4i."
    characterOverride: 0
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 1
    text: "Nh\u01B0ng c\xF4 \u0111\xE3 th\u1EA5y r\u1ED3i."
    characterOverride: 0
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 1
    text: "L\u1EA7n sau c\xF2n d\xE1m giao c\u1EADu \xE0?"
    characterOverride: 0
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 0
    text: "T\u1EDB ch\u1EC9 c\u1EA7n ngh\u1EC9 ch\xFAt."
    characterOverride: 0
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
