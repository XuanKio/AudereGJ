  m_Script: {fileID: 11500000, guid: 988dc6f5856c55141a8b5eb029f35e6d, type: 3}
  m_Name: Dialogue_D3_SLEEPLESS
  m_EditorClassIdentifier: 
  dialogueId: d3-sleepless
  leftCharacter: 1
  rightCharacter: 4
  leftPortraitOverride: {fileID: 4102350588037513078, guid: f24416efd39bdb9469a2068f6e9639c4, type: 3}
  rightPortraitOverride: {fileID: -8522945175667249623, guid: 185e3c99ab0def940b195570629d5076, type: 3}
  lines:
  - speaker: 0
    text: "Xin l\u1ED7i\u2026 c\u1EADu v\u1EEBa n\xF3i g\xEC?"
    characterOverride: 0
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 1
    text: "Audere, c\u1EADu m\u1EC7t \xE0?"
    characterOverride: 0
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 0
    text: "\u0110\xEAm qua t\u1EDB c\u1EE9 t\u1EC9nh gi\u1EA5c."
    characterOverride: 0
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 0
    text: "Nh\u1EAFm m\u1EAFt l\u1EA1i l\xE0 g\u1EB7p gi\u1EA5c m\u01A1 \u0111\xF3."
    characterOverride: 0
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 1
    text: "V\u1EADy c\u1EADu ngh\u1EC9 ch\xFAt nh\xE9."
    characterOverride: 0
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 0
    text: "Ch\u1EC9 h\u01A1i ch\xF3ng m\u1EB7t th\xF4i."
    characterOverride: 0
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
