  dialogueId: d3-sleepless
  leftCharacter: 1
  rightCharacter: 4
  leftPortraitOverride: {fileID: 4102350588037513078, guid: f24416efd39bdb9469a2068f6e9639c4, type: 3}
  rightPortraitOverride: {fileID: -8522945175667249623, guid: 185e3c99ab0def940b195570629d5076, type: 3}
  lines:
  - speaker: 0
    text: "Xin l\u1ED7i\u2026 c\u1EADu n\xF3i g\xEC?"
    characterOverride: 0
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 1
    text: "C\u1EADu m\u1EC7t \xE0?"
    characterOverride: 0
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 0
    text: "\u0110\xEAm qua t\u1EDB c\u1EE9 t\u1EC9nh gi\u1EA5c."
    characterOverride: 0
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 0
    text: "L\u1EA1i m\u01A1 th\u1EA5y m\xECnh r\u01A1i."
    characterOverride: 0
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 1
    text: "Ngh\u1EC9 ch\xFAt nh\xE9."
    characterOverride: 0
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 0
    text: "T\u1EDB h\u01A1i ch\xF3ng m\u1EB7t\u2026"
    characterOverride: 0
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
