    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 0
    text: "L\u1EA7n \u0111\u1EA7u l\xE0m c\xF9ng m\u1ECDi ng\u01B0\u1EDDi\u2026"
    characterOverride: 0
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 0
    text: "Em s\u1EE3 kh\xF4ng theo k\u1ECBp."
