MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 988dc6f5856c55141a8b5eb029f35e6d, type: 3}
  m_Name: Dialogue_D1_HOME_MORNING
  m_EditorClassIdentifier: 
  dialogueId: d1-home-morning-opening
  leftCharacter: 1
  rightCharacter: 2
  lines:
  - speaker: 1
    text: "Audere\u2026 d\u1EADy th\xF4i. C\u1EADu s\u1EAFp mu\u1ED9n r\u1ED3i."
  - speaker: 0
    text: "\u1EEAm\u2026 m\u1EA5y gi\u1EDD r\u1ED3i?"
  - speaker: 1
    text: "\u0110\u1EE7 mu\u1ED9n \u0111\u1EC3 c\u1EADu \u0111\u1EEBng th\u1EED ng\u1EE7
      th\xEAm n\u0103m ph\xFAt n\u1EEFa."
  - speaker: 0
    text: "\u2026T\u1EDB \u0111ang d\u1EADy m\xE0."
  - speaker: 1
    text: "\u1EEA. Ch\u01B0a c\u1EA7n ngh\u0129 h\u1EBFt m\u1ECDi th\u1EE9 ngay \u0111\xE2u. M\xECnh \u0111\xE1nh r\u0103ng tr\u01B0\u1EDBc nh\xE9."
  - speaker: 0
    text: "\u0110\u01B0\u1EE3c r\u1ED3i\u2026"
  - speaker: 1
    text: "T\u1EDB \u0111i c\xF9ng c\u1EADu."
