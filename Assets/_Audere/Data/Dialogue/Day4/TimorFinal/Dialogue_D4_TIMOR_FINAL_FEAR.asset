  m_Script: {fileID: 11500000, guid: 988dc6f5856c55141a8b5eb029f35e6d, type: 3}
  m_Name: Dialogue_D4_TIMOR_FINAL_FEAR
  m_EditorClassIdentifier: 
  dialogueId: D4_TIMOR_FINAL_FEAR
  leftCharacter: 1
  rightCharacter: 2
  leftPortraitOverride: {fileID: 5111810106087816393, guid: b7d038e70866c98478cb41d1c19a092d, type: 3}
  rightPortraitOverride: {fileID: 4635894209233862288, guid: 402a6704a07a4bc49a4c347dd1722afe, type: 3}
  lines:
  - speaker: 1
    text: "M\u1ED9t l\u1EA7n h\u1ECD gi\xFAp\u2026"
    characterOverride: 0
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 1
    text: "kh\xF4ng c\xF3 ngh\u0129a l\u1EA7n sau h\u1ECD c\u0169ng gi\xFAp."
    characterOverride: 0
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 1
    text: "M\u1ED9t l\u1EA7n c\u1EADu n\xF3i \u0111\u01B0\u1EE3c\u2026"
    characterOverride: 0
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 1
    text: "kh\xF4ng c\xF3 ngh\u0129a c\u1EADu s\u1EBD kh\xF4ng l\xE0m h\u1ECFng."
    characterOverride: 0
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 1
    text: "C\u1EADu s\u1EBD l\u1EA1i n\xF3i sai."
    characterOverride: 0
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 1
    text: "C\u1EADu s\u1EBD l\u1EA1i \u0111\u1EE9ng im."
    characterOverride: 0
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 1
    text: "C\u1EADu s\u1EBD l\u1EA1i khi\u1EBFn m\u1ECDi ng\u01B0\u1EDDi ph\u1EA3i
      ch\u1EDD."
    characterOverride: 0
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 1
    text: "R\u1ED3i ch\xEDnh c\u1EADu s\u1EBD b\u1ECB t\u1ED5n th\u01B0\u01A1ng."
    characterOverride: 0
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
