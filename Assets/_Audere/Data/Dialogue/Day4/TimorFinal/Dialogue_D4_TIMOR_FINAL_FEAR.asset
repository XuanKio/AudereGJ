  m_Script: {fileID: 11500000, guid: 988dc6f5856c55141a8b5eb029f35e6d, type: 3}
  m_Name: Dialogue_D4_TIMOR_FINAL_FEAR
  m_EditorClassIdentifier: 
  dialogueId: D4_TIMOR_FINAL_FEAR
  leftCharacter: 1
  rightCharacter: 2
  leftPortraitOverride: {fileID: 5111810106087816393, guid: b7d038e70866c98478cb41d1c19a092d, type: 3}
  rightPortraitOverride: {fileID: 4635894209233862288, guid: 402a6704a07a4bc49a4c347dd1722afe, type: 3}
  lines:
  - speaker: 1
    text: "H\xF4m nay h\u1ECD gi\xFAp\u2026"
    characterOverride: 0
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 1
    text: "l\u1EA7n sau ch\u01B0a ch\u1EAFc \u0111\xE2u."
    characterOverride: 0
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 1
    text: "H\xF4m nay c\u1EADu n\xF3i \u0111\u01B0\u1EE3c\u2026"
    characterOverride: 0
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 1
    text: "l\u1EA7n sau v\u1EABn c\xF3 th\u1EC3 h\u1ECFng."
    characterOverride: 0
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 1
    text: "R\u1ED3i l\u1EA1i n\xF3i sai."
    characterOverride: 0
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 1
    text: "R\u1ED3i l\u1EA1i \u0111\u1EE9ng im."
    characterOverride: 0
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 1
    text: "B\u1EAFt m\u1ECDi ng\u01B0\u1EDDi ch\u1EDD."
    characterOverride: 0
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 1
    text: "Ch\xEDnh c\u1EADu s\u1EBD \u0111au th\xF4i."
    characterOverride: 0
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
