--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 988dc6f5856c55141a8b5eb029f35e6d, type: 3}
  m_Name: Dialogue_D4_TIMOR_FINAL_VICTORY_RECONCILIATION
  m_EditorClassIdentifier: 
  dialogueId: D4_TIMOR_FINAL_VICTORY_RECONCILIATION
  leftCharacter: 1
  rightCharacter: 2
  leftPortraitOverride: {fileID: 5003323414229244817, guid: aef14cf774eb96745a1ce7b2b831128f, type: 3}
  rightPortraitOverride: {fileID: 4335302707972937840, guid: 5d2b3fc096225e44a80f7c7be67ca463, type: 3}
  lines:
  - speaker: 0
    text: "Timor, t\u1EDB bi\u1EBFt c\u1EADu t\u1EEBng gi\xFAp t\u1EDB."
    characterOverride: 0
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 0
    text: "C\u1EADu \u0111\xE3 \u1EDF c\u1EA1nh t\u1EDB r\u1EA5t l\xE2u."
    characterOverride: 0
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 0
    text: "Nh\u01B0ng t\u1EDB kh\xF4ng c\xF2n b\xE9 nh\u01B0 ng\xE0y \u1EA5y."
    characterOverride: 0
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 0
    text: "H\xE3y th\u1EED tin t\u1EDB m\u1ED9t l\u1EA7n \u0111\u01B0\u1EE3c kh\xF4ng?"
    characterOverride: 0
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 0
    text: "V\xE0 th\u1EED tin ng\u01B0\u1EDDi kh\xE1c c\u0169ng c\xF3 th\u1EC3 \u1EDF
      l\u1EA1i."
    characterOverride: 0
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 1
    text: "T\u1EDB s\u1EE3 c\u1EADu kh\xF4ng c\u1EA7n t\u1EDB n\u1EEFa."
    characterOverride: 0
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 0
    text: "T\u1EDB v\u1EABn c\u1EA7n c\u1EADu."
    characterOverride: 0
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 0
    text: "Nh\u01B0ng t\u1EDB c\u1EA7n \u0111\u01B0\u1EE3c t\u1EF1 b\u01B0\u1EDBc
      \u0111i."
    characterOverride: 0
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 1
    text: "\u2026\u0110\u01B0\u1EE3c. T\u1EDB s\u1EBD th\u1EED."
    characterOverride: 0
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
