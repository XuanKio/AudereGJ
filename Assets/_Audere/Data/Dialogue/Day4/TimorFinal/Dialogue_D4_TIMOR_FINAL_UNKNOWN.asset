  lines:
  - speaker: 1
    text: "C\u1EADu kh\xF4ng th\u1EC3 bi\u1EBFt tr\u01B0\u1EDBc \u0111\u01B0\u1EE3c."
    characterOverride: 0
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 0
    text: "\u1EEA."
    characterOverride: 0
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 0
    text: "T\u1EDB kh\xF4ng bi\u1EBFt h\u1ECD s\u1EBD ngh\u0129 g\xEC."
    characterOverride: 0
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 0
    text: "T\u1EDB kh\xF4ng bi\u1EBFt m\xECnh c\xF3 n\xF3i sai kh\xF4ng."
    characterOverride: 0
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
