  - speaker: 0
    text: "T\u1EDB v\u1EABn t\u1EDBi l\u1EDBp \u0111\u01B0\u1EE3c."
    characterOverride: 0
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 0
