  m_Script: {fileID: 11500000, guid: 988dc6f5856c55141a8b5eb029f35e6d, type: 3}
  m_Name: Dialogue_D4_SMALL_TALK
  m_EditorClassIdentifier: 
  dialogueId: D4_CROWD_SMALL_TALK
  leftCharacter: 1
  rightCharacter: 4
  leftPortraitOverride: {fileID: 4102350588037513078, guid: f24416efd39bdb9469a2068f6e9639c4, type: 3}
  rightPortraitOverride: {fileID: -8522945175667249623, guid: 185e3c99ab0def940b195570629d5076, type: 3}
  lines:
  - speaker: 0
    text: "T\u1EDB t\u01B0\u1EDFng m\u1ECDi ng\u01B0\u1EDDi \u0111ang c\u01B0\u1EDDi."
    characterOverride: 0
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 1
    text: "T\u1EDB ch\u1EC9 th\u1EA5y c\u1EADu ng\xE3."
    characterOverride: 0
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 1
    text: "\u0110\u1ED3 \u0111\u1EC3 \u0111\xF3 \u0111\xE3. M\xECnh ng\u1ED3i xu\u1ED1ng
      nh\xE9?"
    characterOverride: 0
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 0
    text: "Nh\u01B0ng c\xF2n \u0111\u1ED3 c\xF4 nh\u1EDD\u2026"
    characterOverride: 0
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 1
    text: "L\xE1t n\u1EEFa m\xECnh mang ti\u1EBFp."
    characterOverride: 0
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
