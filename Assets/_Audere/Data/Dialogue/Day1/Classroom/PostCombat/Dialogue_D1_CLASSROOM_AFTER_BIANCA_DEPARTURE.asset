  lines:
  - speaker: 0
    text: "Tay t\u1EDB v\u1EABn run."
    portraitOverride: {fileID: 0}
  - speaker: 1
    text: "T\u1EDB bi\u1EBFt."
    portraitOverride: {fileID: 0}
  - speaker: 0
    text: "Nh\u01B0ng t\u1EDB \u0111\xE3 n\xF3i \u0111\u01B0\u1EE3c."
    portraitOverride: {fileID: 5003323414229244817, guid: aef14cf774eb96745a1ce7b2b831128f, type: 3}
  - speaker: 1
    text: "\u1EEA."
    portraitOverride: {fileID: 0}
  - speaker: 0
    text: Timor.
    portraitOverride: {fileID: 0}
  - speaker: 1
    text: "\u1EEA?"
    portraitOverride: {fileID: 0}
  - speaker: 0
    text: "C\u1EA3m \u01A1n v\xEC \u0111\xE3 \u1EDF \u0111\xF3."
    portraitOverride: {fileID: 0}
  - speaker: 1
    text: "T\u1EDB v\u1EABn lu\xF4n \u1EDF \u0111\xE2y m\xE0."
    portraitOverride: {fileID: 188140060781976214, guid: 8b9bf032ca2b2d745b01ed08e5c65d23, type: 3}
