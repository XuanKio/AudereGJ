  lines:
  - speaker: 1
    text: "Trang tr\xED, \u0111\u1ED3 \u0103n, tr\xF2 ch\u01A1i\u2026"
    characterOverride: 0
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 1
    text: "C\xE1c em ch\u1ECDn ph\u1EA7n m\xECnh th\xEDch nh\xE9."
    characterOverride: 0
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 1
    text: "L\xE1t n\u1EEFa ghi t\xEAn v\xE0o danh s\xE1ch."
    characterOverride: 0
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 1
    text: "M\u1ED9t vi\u1EC7c v\u1EEBa s\u1EE9c l\xE0 \u0111\u1EE7."
    characterOverride: 0
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 1
    text: "Kh\xF4ng c\u1EA7n v\u1ED9i \u0111\xE2u."
    characterOverride: 0
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
