  m_Script: {fileID: 11500000, guid: 988dc6f5856c55141a8b5eb029f35e6d, type: 3}
  m_Name: Dialogue_D1_CLASSROOM_TIMOR_INTERVENES
  m_EditorClassIdentifier: 
  dialogueId: d1-classroom-timor-intervenes
  leftCharacter: 1
  rightCharacter: 2
  leftPortraitOverride: {fileID: 5111810106087816393, guid: b7d038e70866c98478cb41d1c19a092d, type: 3}
  rightPortraitOverride: {fileID: 1802169272185732355, guid: 056875fa18e556d4cb0aba789bc44c9f, type: 3}
  lines:
  - speaker: 0
    text: "Tay t\u1EDB c\u1EE9 run."
    portraitOverride: {fileID: 0}
  - speaker: 0
    text: "T\u1EDB mu\u1ED1n tr\u1EA3 l\u1EDDi\u2026"
    portraitOverride: {fileID: 0}
  - speaker: 0
    text: "Nh\u01B0ng trong \u0111\u1EA7u ch\u1EC9 b\u1EA3o: tr\u1ED1n \u0111i."
    portraitOverride: {fileID: 0}
  - speaker: 1
    text: "\u0110\u1EEBng tr\u1EA3 l\u1EDDi v\u1ED9i."
    portraitOverride: {fileID: 0}
  - speaker: 1
    text: "Nh\xECn t\u1EDB n\xE0y."
    portraitOverride: {fileID: 0}
  - speaker: 1
    text: "N\u1ED7i lo \u0111ang tr\u1EA3 l\u1EDDi thay c\u1EADu."
    portraitOverride: {fileID: 0}
  - speaker: 0
    text: "\u2026T\u1EDB kh\xF4ng mu\u1ED1n n\xF3 ch\u1ECDn thay n\u1EEFa."
    portraitOverride: {fileID: 0}
  - speaker: 0
    text: "T\u1EDB ph\u1EA3i t\u1EF1 \u0111\u1ED1i di\u1EC7n v\u1EDBi n\xF3."
    portraitOverride: {fileID: 0}
  - speaker: 1
    text: "\u1EEA. T\u1EDB s\u1EBD \u1EDF \u0111\xE2y."
    portraitOverride: {fileID: 4595680028844339828, guid: e0fa04c6868ef2a408bad3c9b70fb4dc, type: 3}
