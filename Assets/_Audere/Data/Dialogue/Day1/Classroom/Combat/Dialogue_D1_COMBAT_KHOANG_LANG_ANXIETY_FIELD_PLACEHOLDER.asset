  lines:
  - speaker: 1
    text: "R\u1ED3i c\xF4 \u1EA5y h\u1ECFi th\xEAm th\xEC sao?"
    characterOverride: 0
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 1
    text: "R\u1ED3i ph\u1EA3i l\xE0m c\xF9ng m\u1ECDi ng\u01B0\u1EDDi."
    characterOverride: 0
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 1
    text: "L\xE0m kh\xF4ng t\u1ED1t th\xEC sao?"
    characterOverride: 0
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 1
    text: "\u0110\u1ED3ng \xFD r\u1ED3i \u0111\xE2u r\xFAt l\u1EA1i \u0111\u01B0\u1EE3c."
