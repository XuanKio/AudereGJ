  lines:
  - speaker: 1
    text: "M\xE1i che kia. B\u1EBFn xe \u0111\u1EA5y."
    characterOverride: 0
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 0
    text: "Xa h\u01A1n t\u1EDB nh\u1EDB."
    characterOverride: 0
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 1
    text: "S\u1EAFp t\u1EDBi r\u1ED3i."
    characterOverride: 0
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 1
    text: "C\u1EE9 nh\xECn \u0111o\u1EA1n ngay tr\u01B0\u1EDBc m\u1EB7t th\xF4i."
    characterOverride: 0
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 0
    text: "\u2026\u1EEA."
