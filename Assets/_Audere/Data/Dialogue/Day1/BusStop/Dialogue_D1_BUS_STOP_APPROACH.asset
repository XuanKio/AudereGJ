  m_Script: {fileID: 11500000, guid: 988dc6f5856c55141a8b5eb029f35e6d, type: 3}
  m_Name: Dialogue_D1_BUS_STOP_APPROACH
  m_EditorClassIdentifier: 
  dialogueId: d1-bus-stop-approach
  leftCharacter: 1
  rightCharacter: 2
  leftPortraitOverride: {fileID: -458334604, guid: 6996de3b28ad9a1448c8c318b9f09ff4, type: 3}
  rightPortraitOverride: {fileID: 4595680028844339828, guid: e0fa04c6868ef2a408bad3c9b70fb4dc, type: 3}
  lines:
  - speaker: 1
    text: "Th\u1EA5y m\xE1i che ph\xEDa tr\u01B0\u1EDBc kh\xF4ng? B\u1EBFn xe \u0111\u1EA5y."
    portraitOverride: {fileID: 0}
  - speaker: 0
    text: "Xa h\u01A1n t\u1EDB nh\u1EDB."
    portraitOverride: {fileID: 0}
  - speaker: 1
    text: "Ch\u1EC9 d\xE0i h\u01A1n m\u1ED9t ch\xFAt th\xF4i."
    portraitOverride: {fileID: 0}
  - speaker: 1
    text: "\u0110\u1EEBng nh\xECn h\u1EBFt c\u1EA3 qu\xE3ng. C\u1EE9 lo \u0111o\u1EA1n
      ngay tr\u01B0\u1EDBc m\u1EB7t c\u1EADu tr\u01B0\u1EDBc nh\xE9."
    portraitOverride: {fileID: 0}
  - speaker: 0
    text: "\u2026\u1EEA."
    portraitOverride: {fileID: 0}
