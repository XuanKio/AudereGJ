  m_Script: {fileID: 11500000, guid: 988dc6f5856c55141a8b5eb029f35e6d, type: 3}
  m_Name: Dialogue_D1_BUS_STOP_APPROACH
  m_EditorClassIdentifier: 
  dialogueId: d1-bus-stop-approach
  leftCharacter: 1
  rightCharacter: 2
  lines:
  - speaker: 1
    text: "Thấy mái che phía trước không? Bến xe đấy."
  - speaker: 0
    text: "Xa hơn tớ nhớ."
  - speaker: 1
    text: "Chỉ dài hơn một chút thôi."
  - speaker: 1
    text: "Đừng nhìn hết cả quãng. Cứ lo đoạn ngay trước mặt cậu trước nhé."
  - speaker: 0
    text: "…Ừ."
