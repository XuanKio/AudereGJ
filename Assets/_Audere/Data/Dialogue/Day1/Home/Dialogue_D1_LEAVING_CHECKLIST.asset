  lines:
  - speaker: 1
    text: "Cặp?"
  - speaker: 0
    text: "Có."
  - speaker: 1
    text: "Điện thoại?"
  - speaker: 0
    text: "Có."
  - speaker: 1
    text: "Chìa khóa?"
  - speaker: 0
    text: "…Có."
  - speaker: 1
    text: "Cậu vừa kiểm tra túi lần nữa đúng không?"
  - speaker: 0
    text: "Cho chắc thôi."
  - speaker: 1
    text: "Chìa khóa vẫn ở đó. Tớ nhìn thấy mà."
  - speaker: 0
    text: "Được rồi. Đi thôi."
