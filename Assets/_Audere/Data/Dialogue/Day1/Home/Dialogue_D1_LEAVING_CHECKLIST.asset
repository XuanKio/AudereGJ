  lines:
  - speaker: 1
    text: "C\u1EB7p?"
    portraitOverride: {fileID: 0}
  - speaker: 0
    text: "C\xF3."
    portraitOverride: {fileID: 0}
  - speaker: 1
    text: "\u0110i\u1EC7n tho\u1EA1i?"
    portraitOverride: {fileID: 0}
  - speaker: 0
    text: "C\xF3."
    portraitOverride: {fileID: 0}
  - speaker: 1
    text: "Ch\xECa kh\xF3a?"
    portraitOverride: {fileID: 0}
  - speaker: 0
    text: "\u2026C\xF3."
    portraitOverride: {fileID: 0}
  - speaker: 1
    text: "C\u1EADu v\u1EEBa ki\u1EC3m tra t\xFAi l\u1EA7n n\u1EEFa \u0111\xFAng
      kh\xF4ng?"
    portraitOverride: {fileID: 0}
  - speaker: 0
    text: "Cho ch\u1EAFc th\xF4i."
    portraitOverride: {fileID: 0}
  - speaker: 1
    text: "Ch\xECa kh\xF3a v\u1EABn \u1EDF \u0111\xF3. T\u1EDB nh\xECn th\u1EA5y
      m\xE0."
    portraitOverride: {fileID: 0}
  - speaker: 0
    text: "\u0110\u01B0\u1EE3c r\u1ED3i. \u0110i th\xF4i."
    portraitOverride: {fileID: -458334604, guid: 6996de3b28ad9a1448c8c318b9f09ff4, type: 3}
