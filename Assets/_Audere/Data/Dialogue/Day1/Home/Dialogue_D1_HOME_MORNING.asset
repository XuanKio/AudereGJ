MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 988dc6f5856c55141a8b5eb029f35e6d, type: 3}
  m_Name: Dialogue_D1_HOME_MORNING
  m_EditorClassIdentifier: 
  dialogueId: d1-home-morning-opening
  leftCharacter: 1
  rightCharacter: 2
  lines:
  - speaker: 1
    text: "Audere… dậy thôi. Muộn thật rồi đấy."
  - speaker: 0
    text: "Ừm… cho tớ một phút."
  - speaker: 1
    text: "Một phút của cậu thường dài lắm."
  - speaker: 0
    text: "…Mấy giờ rồi?"
  - speaker: 1
    text: "Vẫn kịp, nếu mình bắt đầu ngay bây giờ. Chưa cần nghĩ tới cả buổi sáng đâu."
  - speaker: 1
    text: "Đánh răng trước nhé."
  - speaker: 0
    text: "Ừ… tớ dậy đây."
  - speaker: 1
    text: "Tớ đi cùng cậu."
