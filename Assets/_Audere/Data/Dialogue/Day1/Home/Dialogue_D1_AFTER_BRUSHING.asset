  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 988dc6f5856c55141a8b5eb029f35e6d, type: 3}
  m_Name: Dialogue_D1_AFTER_BRUSHING
  m_EditorClassIdentifier: 
  dialogueId: d1-home-after-brushing
  leftCharacter: 1
  rightCharacter: 2
  lines:
  - speaker: 0
    text: "Bạc hà cay quá… nhưng tỉnh thật."
  - speaker: 1
    text: "Ít nhất mắt cậu cũng chịu mở rồi."
  - speaker: 0
    text: "Tớ vẫn đang mở mà."
  - speaker: 1
    text: "Ừ, mở được một nửa. Thế là tiến bộ rồi."
  - speaker: 1
    text: "Bố cậu để bánh mì trong bếp đấy. Mình ăn một chút rồi đi."
  - speaker: 0
    text: "Vẫn còn kịp chứ?"
  - speaker: 1
    text: "Kịp. Cứ lo bữa sáng trước đã, phần còn lại có tớ nhắc."
