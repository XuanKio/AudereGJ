  m_Script: {fileID: 11500000, guid: 988dc6f5856c55141a8b5eb029f35e6d, type: 3}
  m_Name: Dialogue_D1_AFTER_BRUSHING
  m_EditorClassIdentifier: 
  dialogueId: d1-home-after-brushing
  leftCharacter: 1
  rightCharacter: 2
  leftPortraitOverride: {fileID: -458334604, guid: 6996de3b28ad9a1448c8c318b9f09ff4, type: 3}
  rightPortraitOverride: {fileID: 4595680028844339828, guid: e0fa04c6868ef2a408bad3c9b70fb4dc, type: 3}
  lines:
  - speaker: 0
    text: "B\u1EA1c h\xE0 cay qu\xE1\u2026 t\u1EC9nh th\u1EADt."
    characterOverride: 0
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 1
    text: "M\u1EAFt ch\u1ECBu m\u1EDF r\u1ED3i nh\u1EC9."
    characterOverride: 0
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 0
    text: "T\u1EDB v\u1EABn m\u1EDF m\xE0."
    characterOverride: 0
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 1
    text: "\u1EEA, m\u1EDF \u0111\u01B0\u1EE3c n\u1EEDa r\u1ED3i."
    characterOverride: 0
    portraitOverride: {fileID: 188140060781976214, guid: 8b9bf032ca2b2d745b01ed08e5c65d23, type: 3}
    glitchPortraitTransition: 0
  - speaker: 1
    text: "B\u1ED1 c\u1EADu \u0111\u1EC3 b\xE1nh m\xEC trong b\u1EBFp."
    characterOverride: 0
    portraitOverride: {fileID: 4595680028844339828, guid: e0fa04c6868ef2a408bad3c9b70fb4dc, type: 3}
    glitchPortraitTransition: 0
  - speaker: 0
    text: "C\xF2n k\u1ECBp ch\u1EE9?"
    characterOverride: 0
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 1
    text: "K\u1ECBp. \u0102n tr\u01B0\u1EDBc, t\u1EDB nh\u1EAFc gi\u1EDD cho."
    characterOverride: 0
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
