  m_Script: {fileID: 11500000, guid: 988dc6f5856c55141a8b5eb029f35e6d, type: 3}
  m_Name: Dialogue_D1_AFTER_BREAKFAST
  m_EditorClassIdentifier: 
  dialogueId: d1-home-after-breakfast
  leftCharacter: 1
  rightCharacter: 2
  lines:
  - speaker: 0
    text: "Xong rồi."
  - speaker: 1
    text: "Ừ. Còn mỗi việc bước ra khỏi cửa thôi."
  - speaker: 0
    text: "Ra khỏi nhà mới là phần khó."
  - speaker: 1
    text: "Tớ biết."
  - speaker: 1
    text: "Nên mình không nghĩ xa. Kiểm tra đồ trước nhé."
