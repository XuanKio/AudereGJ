  lines:
  - speaker: 1
    text: "Kh\xF4ng tr\u1EA3 l\u1EDDi c\u0169ng l\xE0 m\u1ED9t c\xE2u tr\u1EA3 l\u1EDDi."
    portraitOverride: {fileID: 0}
  - speaker: 0
    text: "Bianca s\u1EBD ngh\u0129 g\xEC nh\u1EC9?"
    portraitOverride: {fileID: 0}
  - speaker: 1
    text: "Ng\xE0y mai r\u1ED3i t\xEDnh."
    portraitOverride: {fileID: 0}
  - speaker: 1
    text: "Ngh\u1EC9 th\xF4i."
    portraitOverride: {fileID: 0}
