%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 988dc6f5856c55141a8b5eb029f35e6d, type: 3}
  m_Name: Dialogue_D1_HOME_NIGHT_CONCLUSION
  m_EditorClassIdentifier: 
  dialogueId: d1-home-night-conclusion
  leftCharacter: 1
  rightCharacter: 2
  leftPortraitOverride: {fileID: 5111810106087816393, guid: b7d038e70866c98478cb41d1c19a092d, type: 3}
  rightPortraitOverride: {fileID: -4747829306167941163, guid: cdecd5c621db74b43927eb49d1f04191, type: 3}
  lines:
  - speaker: 1
    text: "C\u1EADu \u0111\xE2u bi\u1EBFt c\xF4 \u1EA5y mu\u1ED1n g\xEC."
    characterOverride: 0
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 0
    text: "T\u1EDB c\xF3 th\u1EC3 h\u1ECFi l\u1EA1i."
    characterOverride: 0
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 1
    text: "N\u1EBFu c\xF4 \u1EA5y nh\u1EDD m\xE3i th\xEC sao?"
    characterOverride: 0
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 0
    text: "Nhi\u1EC1u qu\xE1\u2026 t\u1EDB s\u1EBD t\u1EEB ch\u1ED1i."
    characterOverride: 0
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 1
    text: Audere.
    characterOverride: 0
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 0
    text: "T\u1EDB bi\u1EBFt c\u1EADu lo."
    characterOverride: 0
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 0
    text: "Nh\u01B0ng t\u1EDB mu\u1ED1n tr\u1EA3 l\u1EDDi."
    characterOverride: 0
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 1
    text: "Kh\xF4ng \u0111\u01B0\u1EE3c \u0111\xE2u, Audere."
    characterOverride: 0
    portraitOverride: {fileID: 4635894209233862288, guid: 402a6704a07a4bc49a4c347dd1722afe, type: 3}
    glitchPortraitTransition: 0
  - speaker: 1
    text: "T\u1EDB \u0111\xE3 th\u1EA5y chuy\u1EC7n x\u1EA3y ra r\u1ED3i."
    characterOverride: 0
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 0
    text: "Timor, \u0111\u1EEBng lo."
    characterOverride: 0
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 1
    text: "\u0110\u1EEBng b\u1EA3o t\u1EDB \u0111\u1EEBng lo!"
    characterOverride: 0
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 1
    text: "C\u1EADu ph\u1EA3i nghe t\u1EDB l\u1EA7n n\xE0y."
    characterOverride: 0
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 1
    text: "Tin t\u1EDB \u0111i."
    characterOverride: 0
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 1
    text: "Gi\u1EEF kho\u1EA3ng c\xE1ch v\u1EDBi c\xF4 \u1EA5y."
    characterOverride: 0
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 0
    text: "...T\u1EDB kh\xF4ng mu\u1ED1n."
    characterOverride: 0
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 1
    text: Audere.
    characterOverride: 0
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 0
    text: "L\u1EA7n n\xE0y, \u0111\u1EC3 t\u1EDB t\u1EF1 tr\u1EA3 l\u1EDDi."
    characterOverride: 0
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 1
    text: "T\u1EDB kh\xF4ng th\u1EC3 \u0111\u1EC3 c\u1EADu l\xE0m v\u1EADy."
    characterOverride: 0
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
