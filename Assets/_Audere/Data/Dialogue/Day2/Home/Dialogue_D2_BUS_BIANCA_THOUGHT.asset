  lines:
  - speaker: 0
    text: "Kh\xF4ng bi\u1EBFt Bianca \u0111ang ngh\u0129 g\xEC."
    portraitOverride: {fileID: 0}
  - speaker: 1
    text: "\u0110\u1EEBng \u0111i s\xE1t ng\u01B0\u1EDDi kia."
    portraitOverride: {fileID: 0}
  - speaker: 0
    text: "T\u1EDB ch\u1EC9 \u0111ang ngh\u0129 v\u1EC1 tin nh\u1EAFn."
    portraitOverride: {fileID: 0}
  - speaker: 1
    text: "T\u1EDB bi\u1EBFt."
    portraitOverride: {fileID: 0}
  - speaker: 1
    text: "Nh\xECn \u0111\u01B0\u1EDDng tr\u01B0\u1EDBc \u0111\xE3."
    portraitOverride: {fileID: 0}
