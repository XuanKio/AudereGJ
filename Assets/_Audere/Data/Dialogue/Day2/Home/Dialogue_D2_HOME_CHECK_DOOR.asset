  rightPortraitOverride: {fileID: 0}
  lines:
  - speaker: 1
    text: "C\u1EADu ch\u1EAFc \u0111\xE3 kh\xF3a c\u1EEDa ch\u01B0a?"
    portraitOverride: {fileID: 0}
  - speaker: 0
    text: "T\u1EDB v\u1EEBa kh\xF3a r\u1ED3i."
    portraitOverride: {fileID: 0}
  - speaker: 1
    text: "Th\u1EED tay n\u1EAFm m\u1ED9t l\u1EA7n n\u1EEFa nh\xE9."
    portraitOverride: {fileID: 0}
  - speaker: 0
    text: ...Timor.
    portraitOverride: {fileID: 0}
  - speaker: 1
    text: "M\u1ED9t l\u1EA7n th\xF4i."
    portraitOverride: {fileID: 0}
  - speaker: 0
    text: "...\u1EEA."
    portraitOverride: {fileID: 0}
