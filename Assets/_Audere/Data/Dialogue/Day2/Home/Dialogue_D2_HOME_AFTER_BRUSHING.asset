  dialogueId: d2-home-after-brushing
  leftCharacter: 1
  rightCharacter: 2
  leftPortraitOverride: {fileID: 0}
  rightPortraitOverride: {fileID: 0}
  lines:
  - speaker: 0
    text: "T\u1EDB nh\u1EDB l\xE0 ph\u1EA3i \u0103n s\xE1ng."
    portraitOverride: {fileID: 0}
  - speaker: 1
    text: "\u1EEA."
    portraitOverride: {fileID: 0}
  - speaker: 1
    text: "B\xE1nh m\xEC \u1EDF trong b\u1EBFp."
    portraitOverride: {fileID: 0}
  - speaker: 1
    text: "\u0102n h\u1EBFt r\u1ED3i m\xECnh m\u1EDBi \u0111i."
    portraitOverride: {fileID: 0}
  - speaker: 0
    text: "T\u1EDB t\u1EF1 l\xE0m \u0111\u01B0\u1EE3c."
    portraitOverride: {fileID: 0}
  - speaker: 1
    text: "T\u1EDB bi\u1EBFt."
    portraitOverride: {fileID: 0}
  - speaker: 1
    text: "T\u1EDB ch\u1EC9 mu\u1ED1n ch\u1EAFc c\u1EADu kh\xF4ng b\u1ECF b\u1EEFa."
    portraitOverride: {fileID: 0}
