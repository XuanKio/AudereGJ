  leftPortraitOverride: {fileID: 5111810106087816393, guid: b7d038e70866c98478cb41d1c19a092d, type: 3}
  rightPortraitOverride: {fileID: 7503800403365798388, guid: 03f69c0d5de4d5b4982fff343666a5cb, type: 3}
  lines:
  - speaker: 0
    text: Bianca.
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 1
    text: "\u1EEA?"
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 0
    text: "\u2026L\xFAc n\xE3y c\u1EADu c\xF3 th\u1EA5y t\u1EDB phi\u1EC1n kh\xF4ng?"
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 1
    text: "L\xFAc n\xE0o?"
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 0
    text: "L\xFAc t\u1EDB l\u1EA5y nh\u1EA7m \u1EA5y."
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 1
    text: "Kh\xF4ng."
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 1
    text: "Chuy\u1EC7n \u0111\xF3 b\xECnh th\u01B0\u1EDDng m\xE0."
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 1
    text: "B\u1ECDn m\xECnh \u0111em tr\u1EA3 c\xF9ng nhau nh\xE9."
    portraitOverride: {fileID: 7203529753858926249, guid: 5a29a2e57d0d13b42b26519f3b021631, type: 3}
    glitchPortraitTransition: 0
