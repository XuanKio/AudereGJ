  leftPortraitOverride: {fileID: -458334604, guid: 6996de3b28ad9a1448c8c318b9f09ff4, type: 3}
  rightPortraitOverride: {fileID: -4747829306167941163, guid: cdecd5c621db74b43927eb49d1f04191, type: 3}
  lines:
  - speaker: 1
    text: "C\u1EADu \u1EA5y c\xF3 th\u1EC3 ch\u1EC9 n\xF3i th\u1EBF th\xF4i."
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 1
    text: "C\u1EADu \u0111\xE2u bi\u1EBFt c\u1EADu \u1EA5y th\u1EADt s\u1EF1 ngh\u0129
      g\xEC."
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 0
    text: "\u2026C\u1EADu c\u0169ng \u0111\xE2u bi\u1EBFt."
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 1
    text: "T\u1EDB ch\u1EC9 mu\u1ED1n c\u1EADu c\u1EA9n th\u1EADn."
    portraitOverride: {fileID: 1802169272185732355, guid: 056875fa18e556d4cb0aba789bc44c9f, type: 3}
    glitchPortraitTransition: 0
  - speaker: 0
    text: "\u2026\u1EEA."
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
