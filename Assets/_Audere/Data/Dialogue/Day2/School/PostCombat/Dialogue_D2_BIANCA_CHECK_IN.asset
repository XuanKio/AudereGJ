  m_Name: Dialogue_D2_BIANCA_CHECK_IN
  m_EditorClassIdentifier: 
  dialogueId: d2-bianca-check-in
  leftCharacter: 1
  rightCharacter: 4
  leftPortraitOverride: {fileID: 5111810106087816393, guid: b7d038e70866c98478cb41d1c19a092d, type: 3}
  rightPortraitOverride: {fileID: 7503800403365798388, guid: 03f69c0d5de4d5b4982fff343666a5cb, type: 3}
  lines:
  - speaker: 1
    text: Audere?
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 0
    text: "\u2026\u1EEA."
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 1
    text: "C\u1EADu \u1ED5n kh\xF4ng?"
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 0
    text: "T\u1EDB l\u1EA5y nh\u1EA7m."
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 1
    text: "\u1EEA."
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 1
    text: "\u0110\u1EC3 l\u1EA1i l\xE0 \u0111\u01B0\u1EE3c m\xE0."
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 1
    text: "S\xE1ng nay t\u1EDB c\u0169ng c\u1EA7m nh\u1EA7m danh s\xE1ch."
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 1
    text: "T\u1EDB l\u1EA5y lu\xF4n c\u1EE7a nh\xF3m \u0111\u1ED3 \u0103n."
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 1
    text: "\u0110i n\u1EEDa c\u1EA7u thang m\u1EDBi nh\u1EADn ra."
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
