  lines:
  - speaker: 1
    text: Audere?
    characterOverride: 0
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 0
    text: "\u2026\u1EEA."
    characterOverride: 0
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 1
    text: "C\u1EADu \u1ED5n kh\xF4ng?"
    characterOverride: 0
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 0
    text: "T\u1EDB l\u1EA5y nh\u1EA7m."
    characterOverride: 0
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 1
    text: "\u1EEA, m\xECnh \u0111em tr\u1EA3 th\xF4i."
    characterOverride: 0
    portraitOverride: {fileID: 7503800403365798388, guid: 03f69c0d5de4d5b4982fff343666a5cb, type: 3}
    glitchPortraitTransition: 0
  - speaker: 1
    text: "S\xE1ng nay t\u1EDB c\u0169ng l\u1EA5y nh\u1EA7m danh s\xE1ch."
    characterOverride: 0
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 1
    text: "C\u1EE7a nh\xF3m \u0111\u1ED3 \u0103n \u1EA5y."
    characterOverride: 0
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
