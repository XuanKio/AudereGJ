  m_Script: {fileID: 11500000, guid: 988dc6f5856c55141a8b5eb029f35e6d, type: 3}
  m_Name: Dialogue_D2_HOME_TODAY
  m_EditorClassIdentifier: 
  dialogueId: d2-home-today
  leftCharacter: 1
  rightCharacter: 2
  leftPortraitOverride: {fileID: 4102350588037513078, guid: f24416efd39bdb9469a2068f6e9639c4, type: 3}
  rightPortraitOverride: {fileID: -4747829306167941163, guid: cdecd5c621db74b43927eb49d1f04191, type: 3}
  lines:
  - speaker: 0
    text: "C\xF3 th\u1EC3."
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 1
    text: "\u1EEA."
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 1
    text: "N\xEAn t\u1EDB m\u1EDBi ph\u1EA3i nh\u1EAFc c\u1EADu."
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 1
    text: "C\u1EE9 chu\u1EA9n b\u1ECB cho \u0111i\u1EC1u t\u1EC7 nh\u1EA5t."
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 1
    text: "N\u1EBFu n\xF3 \u0111\u1EBFn, c\u1EADu s\u1EBD kh\xF4ng b\u1ECB b\u1EA5t
      ng\u1EDD."
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 0
    text: "Nh\u01B0ng h\xF4m nay\u2026 n\xF3 kh\xF4ng x\u1EA3y ra."
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
  - speaker: 1
    text: "H\xF4m nay th\xF4i."
    portraitOverride: {fileID: 0}
    glitchPortraitTransition: 0
